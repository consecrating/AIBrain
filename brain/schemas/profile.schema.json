{
  "title": "AIBrain project profile",
  "type": "object",
  "required": ["schema_version", "name", "description", "scope", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "description": {"type": "string"},
    "scope": {"type": "string"},
    "path_markers": {"type": "array", "items": {"type": "string"}},
    "file_markers": {"type": "array", "items": {"type": "string"}},
    "priorities": {"type": "array", "items": {"type": "string"}},
    "rules": {"type": "array", "items": {"type": "string"}},
    "required_context": {"type": "array", "items": {"type": "string"}},
    "skill_preferences": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
